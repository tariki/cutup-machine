{
  "name": "cutup-machine",
  "version": "0.1.0",
  "description": "Claude Code book - Chapter 8 template",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "npx prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "spec-driven-development",
    "claude-code",
    "template"
  ],
  "author": "Tomohiko Ariki",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "kuromoji": "^0.1.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "public/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
